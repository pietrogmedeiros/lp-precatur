{
  "name": "lp-precatur",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de captação de leads da Precatur para eventos (Node.js + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "esbuild app=src/client/main.ts metrics=src/client/metrics.ts --bundle --format=esm --target=es2020 --sourcemap --outdir=public/js --watch=forever",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "esbuild app=src/client/main.ts metrics=src/client/metrics.ts --bundle --minify --format=esm --target=es2020 --outdir=public/js",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}

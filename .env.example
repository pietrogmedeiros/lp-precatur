# Porta e host do servidor
PORT=3000
HOST=0.0.0.0

# Webhook do n8n que recebe os leads (POST JSON)
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/evento
# Webhook dos leads da página /palestra-rafael
N8N_WEBHOOK_URL_PALESTRA_RAFAEL=https://seu-n8n.exemplo.com/webhook/palestra-rafael
N8N_TIMEOUT_MS=10000
# Intervalo de reenvio automático dos leads que falharam (ms)
RETRY_INTERVAL_MS=60000

# Evento e agentes exibidos no formulário (agentes separados por vírgula)
EVENT_NAME=Precatório Summit
AGENTS=Thales,Aline,Thaynara,Tati,Henrique,Rhuan,Calebe,Karol,Vitoria,Matheus,Sanmilly,Ayrton,Laís,Carlos,Chris,Rafael

# Tela de sucesso volta sozinha ao formulário após N segundos (0 = desativa)
AUTO_RESET_SECONDS=15

# Token para baixar o CSV em /admin/leads.csv?token=... (vazio = desativado)
ADMIN_TOKEN=

# Painel /metrics: vazio = aberto; preenchido = pede este token para entrar
METRICS_TOKEN=

# Onde os leads ficam salvos (data/leads.jsonl)
DATA_DIR=data

# Limite de envios por IP por minuto
RATE_LIMIT_PER_MINUTE=60

# true se estiver atrás de proxy/load balancer (Render, Railway, Nginx...)
TRUST_PROXY=false
